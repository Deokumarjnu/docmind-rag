# DocMind RAG Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Required API Keys
# ===========================================

# OpenAI API Key (required for LLM and embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# Optional: LangSmith Observability
# ===========================================

# Enable LangSmith tracing (set to true to enable)
LANGCHAIN_TRACING_V2=false

# LangSmith API Key (only needed if tracing is enabled)
LANGSMITH_API_KEY=

# LangSmith project name
LANGSMITH_PROJECT=docmind-rag

# ===========================================
# Vector Store Configuration
# ===========================================

# ===========================================
# Vector Store: Local Qdrant
# ===========================================

# Qdrant host (default: localhost for local dev, 'qdrant' for Docker)
QDRANT_HOST=localhost

# Qdrant port (default: 6333)
QDRANT_PORT=6333

# ===========================================
# Vector Store: Qdrant Cloud (for deployment)
# ===========================================

# Qdrant Cloud URL (e.g., https://xxx-xxx.aws.cloud.qdrant.io)
# Leave empty for local Qdrant
QDRANT_URL=

# Qdrant Cloud API Key
QDRANT_API_KEY=

# ===========================================
# Collection Settings
# ===========================================

# Collection name for document storage
QDRANT_COLLECTION_NAME=docmind_documents

# ===========================================
# Redis Configuration (for Celery async tasks)
# ===========================================

# Redis URL (default: localhost for local dev, 'redis' for Docker)
REDIS_URL=redis://localhost:6379/0

# ===========================================
# Application Settings
# ===========================================

# Debug mode (set to true for development)
DEBUG=false

# LLM Model (default: gpt-5.2 - best reasoning, 400K context)
LLM_MODEL=gpt-5.2

# Vision Model for charts/handwriting (default: gpt-5.2 - improved chart analysis)
VISION_MODEL=gpt-5.2

# Embedding Model (default: text-embedding-3-large)
EMBEDDING_MODEL=text-embedding-3-large

# Embedding dimensions (must match model: 3072 for text-embedding-3-large)
EMBEDDING_DIMENSIONS=3072

# ===========================================
# Document Processing Settings
# ===========================================

# Chunk size for text splitting (default: 700)
CHUNK_SIZE=700

# Chunk overlap (default: 100)
CHUNK_OVERLAP=100

# Maximum parallel workers for PDF processing (default: 8)
MAX_PARALLEL_WORKERS=8

# Maximum upload file size in MB (default: 100)
MAX_UPLOAD_SIZE_MB=100

